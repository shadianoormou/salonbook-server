{
  "name": "salonbook-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "check": "node --check src/server.js",
    "dev:database": "node scripts/dev-database.js"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "latest",
    "better-auth": "latest",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "mongodb": "^6.20.0",
    "multer": "^2.0.2",
    "stripe": "latest",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.3.0",
    "prettier": "^3.10.1",
    "supertest": "^7.1.0"
  }
}
